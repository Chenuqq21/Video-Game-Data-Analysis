import pandas as pd
import matplotlib.pyplot as plt

# load the data from csv
df = pd.read_csv('vgsales.csv')

# check the first few rows to see if it works
print(df.head())

# check for missing values
print(df.isnull().sum())

# delete missing data to make it clean
df_clean = df.dropna(subset=['Year', 'Publisher'])

# change year to int
df_clean['Year'] = df_clean['Year'].astype(int)

# which genre has the highest sales? 
# first group by genre then sum up the sales
genre_sales = df_clean.groupby('Genre')['Global_Sales'].sum()
top_genres = genre_sales.sort_values(ascending=False).head(5)
print(top_genres)

# check the top 5 platforms
platform_sales = df_clean.groupby('Platform')['Global_Sales'].sum()
top_platforms = platform_sales.sort_values(ascending=False).head(5)
print(top_platforms)

# draw a simple bar chart for top genres
top_genres.plot(kind='bar')
plt.title('Top 5 Genres')
plt.show()

# draw a line chart for yearly sales trend
# only use data before 2016
yearly_sales = df_clean[df_clean['Year'] <= 2016].groupby('Year')['Global_Sales'].sum()
plt.plot(yearly_sales)
plt.title('Global Sales Trend')
plt.show()

# summary of findings
print("The analysis shows that Action and Sports games are the most popular.")
print("Also, video game sales peaked around 2008-2010.")
